// YouTube integrations core schema (Content Publishing + Scheduling).
// NOTE: scalar companyId references (no @relation) to avoid coupling — same as tiktok.prisma.

model YouTubeAccount {
  id             String    @id @default(cuid())
  companyId      String
  channelId      String                       // UCxxxxxxxx
  channelTitle   String?
  avatarUrl      String?
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?
  scopes         String?
  source         String    @default("oauth")
  status         String    @default("connected")
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, channelId])
  @@index([companyId])
  @@map("youtube_accounts")
}

model YouTubeSettings {
  id                String   @id @default(cuid())
  companyId         String   @unique
  clientId          String?
  clientSecret      String?  @db.Text
  redirectUri       String?
  defaultPrivacy    String   @default("private")   // private | unlisted | public
  defaultCategoryId String   @default("22")        // People & Blogs
  maxUploadsPerDay  Int      @default(10)
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@map("youtube_settings")
}

model YouTubeVideo {
  id               String    @id @default(cuid())
  companyId        String
  accountId        String
  title            String
  description      String?   @db.Text
  tags             String?   @db.Text             // CSV أو JSON
  categoryId       String    @default("22")
  privacyStatus    String    @default("private")
  madeForKids      Boolean   @default(false)
  mediaUrl         String                        // /uploads/media/xxx.mp4
  thumbnailUrl     String?
  status           String    @default("SCHEDULED") // SCHEDULED|UPLOADING|PROCESSING|PUBLISHED|FAILED|CANCELLED
  scheduledAt      DateTime?
  startedAt        DateTime?
  publishedAt      DateTime?
  youtubeVideoId   String?
  uploadSessionUri String?   @db.Text
  errorMessage     String?   @db.Text
  attempts         Int       @default(0)
  metadata         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, status])
  @@index([status, scheduledAt])   // 🔑 مهم لاستعلام الـ cron
  @@map("youtube_videos")
}
